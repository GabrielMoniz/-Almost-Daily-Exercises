%% qiworkbook.sty -- shared style for the daily quantum-information workbook
%%
%% Usage:   \usepackage{qiworkbook}           % private build: attempt logs shown
%%          \usepackage[public]{qiworkbook}   % public build: logs hidden unless opted in
%%
%% Intended document class: scrbook (see main.tex).
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{qiworkbook}[2026/09/12 v2.0 Daily QI workbook style]

% ------------------------------------------------------------------ options --
\newif\ifwb@public \wb@publicfalse
\DeclareOption{public}{\wb@publictrue}
\DeclareOption{private}{\wb@publicfalse}
\ProcessOptions\relax

% ----------------------------------------------------------------- packages --
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{calc}
\RequirePackage[margin=2.6cm,headsep=1.2em]{geometry}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{microtype}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{tikz}
\RequirePackage{scrlayer-scrpage}
\RequirePackage[colorlinks=true,linkcolor=wbLink,citecolor=wbLink,%
                urlcolor=wbLink,breaklinks=true,bookmarksnumbered=true,%
                bookmarksopen=true,bookmarksopenlevel=0]{hyperref}
\RequirePackage{bookmark}

% =============================================================================
%  PALETTE -- edit these seven lines to restyle the whole document.
%
%    wbBody    body text, and the "Problem."/"Solution." headwords
%    wbInk     chapter and section headings ("Day 5", entry titles), toolbox
%    wbLink    every hyperlink: TOC, \qref, \usetool, ledger titles, \href
%    wbAccent  the rule under each day heading, filled calendar cells
%    wbGrey    metadata block, attempt log, page header/footer, calendar labels
%    wbFaint   empty calendar cells, the thin rule between entries
%    wbTodo    \todo markers
%
%  For an entirely black-and-white document, set wbBody, wbInk and wbAccent to
%  000000 and wbGrey to 333333.
% =============================================================================
\definecolor{wbBody}{HTML}{000000}
\definecolor{wbInk}{HTML}{16283C}
\definecolor{wbLink}{HTML}{1F4E79}
\definecolor{wbAccent}{HTML}{2E6F8E}
\definecolor{wbGrey}{HTML}{5A6470}
\definecolor{wbFaint}{HTML}{DCE3E8}
\definecolor{wbTodo}{HTML}{B00020}

% Body colour is applied once, at the start of the document, so that nothing
% depends on what happened to be in force beforehand.
\AtBeginDocument{\color{wbBody}}

% =============================================================================
%  Dates.  Everything is stored ISO (YYYY-MM-DD) and rendered from that.
% =============================================================================
\ExplSyntaxOn

\int_new:N \l__wb_y_int
\int_new:N \l__wb_m_int
\int_new:N \l__wb_d_int
\int_new:N \l__wb_dow_int
\int_new:N \l__wb_tmp_int

\tl_new:N \g__wb_datelong_tl
\tl_new:N \g__wb_dateshort_tl
\tl_new:N \g__wb_dateiso_tl

\cs_new:Npn \__wb_month_name:n #1
  {
    \int_case:nnF {#1}
      {
        {1}{January}   {2}{February} {3}{March}     {4}{April}
        {5}{May}       {6}{June}     {7}{July}      {8}{August}
        {9}{September} {10}{October} {11}{November} {12}{December}
      }
      { ?? }
  }
\cs_new:Npn \__wb_month_abbr:n #1
  {
    \int_case:nnF {#1}
      {
        {1}{Jan} {2}{Feb} {3}{Mar} {4}{Apr} {5}{May}  {6}{Jun}
        {7}{Jul} {8}{Aug} {9}{Sep} {10}{Oct} {11}{Nov} {12}{Dec}
      }
      { ?? }
  }
% Sakamoto's table
\cs_new:Npn \__wb_month_t:n #1
  {
    \int_case:nnF {#1}
      {
        {1}{0} {2}{3} {3}{2} {4}{5} {5}{0}  {6}{3}
        {7}{5} {8}{1} {9}{4} {10}{6} {11}{2} {12}{4}
      }
      { 0 }
  }
\cs_new:Npn \__wb_dow_name:n #1
  {
    \int_case:nnF {#1}
      {
        {0}{Sunday}   {1}{Monday} {2}{Tuesday} {3}{Wednesday}
        {4}{Thursday} {5}{Friday} {6}{Saturday}
      }
      { ?? }
  }

% expandable: day of week, 0 = Sunday
\cs_new:Npn \__wb_dow:nnn #1#2#3
  {
    \int_mod:nn
      {
        \int_eval:n { #1 - ( \int_compare:nNnTF {#2} < {3} {1} {0} ) }
        + \int_div_truncate:nn
            { \int_eval:n { #1 - ( \int_compare:nNnTF {#2} < {3} {1} {0} ) } } { 4 }
        - \int_div_truncate:nn
            { \int_eval:n { #1 - ( \int_compare:nNnTF {#2} < {3} {1} {0} ) } } { 100 }
        + \int_div_truncate:nn
            { \int_eval:n { #1 - ( \int_compare:nNnTF {#2} < {3} {1} {0} ) } } { 400 }
        + \__wb_month_t:n {#2} + #3
      } { 7 }
  }

\cs_new_protected:Npn \__wb_date_split:w #1-#2-#3 \q_stop
  {
    \int_set:Nn \l__wb_y_int {#1}
    \int_set:Nn \l__wb_m_int {#2}
    \int_set:Nn \l__wb_d_int {#3}
  }

\tl_new:N \l__wb_iso_tl
\cs_new_protected:Npn \wb_setdate:n #1
  {
    % expand first: the argument is usually a tl variable, and the splitter is
    % delimited, so it must see the literal YYYY-MM-DD
    \tl_set:Nx \l__wb_iso_tl {#1}
    \tl_if_in:NnF \l__wb_iso_tl { - }
      {
        \msg_warning:nnn { qiworkbook } { bad-date } { \l__wb_iso_tl }
        \tl_set:Nn \l__wb_iso_tl { 1970-01-01 }
      }
    \tl_gset_eq:NN \g__wb_dateiso_tl \l__wb_iso_tl
    \exp_after:wN \__wb_date_split:w \l__wb_iso_tl \q_stop
    \int_set:Nn \l__wb_dow_int
      { \__wb_dow:nnn { \l__wb_y_int } { \l__wb_m_int } { \l__wb_d_int } }
    \tl_gset:Nx \g__wb_dateshort_tl
      {
        \int_use:N \l__wb_d_int \c_space_tl
        \__wb_month_name:n { \l__wb_m_int } \c_space_tl
        \int_use:N \l__wb_y_int
      }
    \tl_gset:Nx \g__wb_datelong_tl
      {
        \__wb_dow_name:n { \l__wb_dow_int } ,
        \c_space_tl \tl_use:N \g__wb_dateshort_tl
      }
  }

\msg_new:nnn { qiworkbook } { bad-date } { Date~'#1'~is~not~ISO~YYYY-MM-DD. }
\cs_new_eq:NN \wbsetdate   \wb_setdate:n
\cs_new:Npn  \wbdateshort  { \tl_use:N \g__wb_dateshort_tl }
\cs_new:Npn  \wbdatelong   { \tl_use:N \g__wb_datelong_tl }
% Format an arbitrary ISO date inline, e.g. \wbdate{2026-09-11}
\cs_new_protected:Npn \wbdate #1
  { \group_begin: \wb_setdate:n {#1} \wbdateshort \group_end: }

% ---- leap years and day-of-year, for the calendar ---------------------------
\cs_new:Npn \__wb_isleap:n #1
  {
    \int_compare:nNnTF
      { \int_mod:nn {#1} {400} } = {0} {1}
      {
        \int_compare:nNnTF { \int_mod:nn {#1} {100} } = {0} {0}
          { \int_compare:nNnTF { \int_mod:nn {#1} {4} } = {0} {1} {0} }
      }
  }
\cs_new:Npn \__wb_cumdays:n #1
  {
    \int_case:nnF {#1}
      {
        {1}{0}   {2}{31}  {3}{59}  {4}{90}  {5}{120} {6}{151}
        {7}{181} {8}{212} {9}{243} {10}{273} {11}{304} {12}{334}
      }
      { 0 }
  }
% day of year (1-based)
\cs_new:Npn \__wb_doy:nnn #1#2#3
  {
    \int_eval:n
      {
        \__wb_cumdays:n {#2} + #3
        + \int_compare:nNnTF {#2} > {2} { \__wb_isleap:n {#1} } { 0 }
      }
  }
\cs_new:Npn \__wb_pad:n #1
  { \int_compare:nNnT {#1} < {10} {0} \int_eval:n {#1} }

\ExplSyntaxOff

% scrbook has no abstract environment; provide a quiet one.
\providecommand{\abstractname}{Abstract}
\@ifundefined{abstract}{%
  \newenvironment{abstract}{%
    \begin{center}\bfseries\color{wbInk}\abstractname\end{center}%
    \begingroup\small\setlength{\leftskip}{2em}\setlength{\rightskip}{2em}%
    \noindent\ignorespaces}{\par\endgroup\bigskip}}{}

% =============================================================================
%  Theorem-like environments
% =============================================================================
\theoremstyle{plain}
\newtheorem{lemma}{Lemma}[chapter]
\newtheorem{proposition}[lemma]{Proposition}
\newtheorem{theorem}[lemma]{Theorem}
\newtheorem{corollary}[lemma]{Corollary}
\newtheorem{claim}[lemma]{Claim}

\theoremstyle{definition}
\newtheorem*{problem}{Problem}
\newtheorem*{solution}{Solution}
\newtheorem*{scratch}{Scratch}

\theoremstyle{remark}
\newtheorem*{remark}{Remark}
\newtheorem*{takeaway}{Takeaway}

% =============================================================================
%  Sectioning:  \daysession{n}{ISO date}  ->  chapter
%               entry environment          ->  section
% =============================================================================
\setkomafont{section}{\normalfont\large\bfseries\color{wbInk}}
\setkomafont{subsection}{\normalfont\normalsize\bfseries\color{wbInk}}

\newcommand{\wbrule}{\par\nointerlineskip
  {\color{wbAccent}\hrule height 0.9pt}\par}
\newcommand{\wbthinrule}{\par\nointerlineskip
  {\color{wbFaint}\hrule height 0.5pt}\par}

\newcommand{\wb@curday}{0}

% \daysession{5}{2026-09-11}
\newcommand{\wb@sessiondate}{}
\newcommand{\daysession}[2]{%
  \wbsetdate{#2}%
  \gdef\wb@sessiondate{#2}%
  \cleardoublepage
  \setcounter{chapter}{\numexpr#1-1\relax}%
\stepcounter{chapter}%
  \renewcommand{\wb@curday}{#1}%
  \phantomsection
  \hypertarget{day#1}{}%
  \chapter*{\raggedright\color{wbInk}Day~#1}%
  \vspace{-1.2\baselineskip}%
  {\raggedleft\small\scshape\color{wbGrey}\wbdatelong\par}%
  \wbrule
  \addcontentsline{toc}{chapter}{Day~#1 \textemdash\ \wbdateshort}%
  \markright{Day~#1 \quad\textbullet\quad \wbdateshort}%
  \vspace{0.8\baselineskip}%
}

% link back to a day:  \dayref{4}
\newcommand{\dayref}[1]{\hyperlink{day#1}{Day~#1}}
% link back to a problem:  \qref{Q004}  ->  "Q004 (Day 4)"
\newcommand{\qref}[1]{%
  \hyperlink{#1}{#1}%
  \expandafter\ifx\csname wb@qday@#1\endcsname\relax
    \PackageWarning{qiworkbook}{Unknown problem id #1 (rerun LaTeX)}%
  \else
    \ (\dayref{\csname wb@qday@#1\endcsname})%
  \fi}

% =============================================================================
%  Entry environment
% =============================================================================
\newcommand{\wb@cur@id}{}
\newcommand{\wb@topicfrozen}{}
\newcommand{\wb@cur@title}{}

\ExplSyntaxOn
\tl_new:N \l_wb_meta_topic_tl
\tl_new:N \l_wb_meta_est_tl
\tl_new:N \l_wb_meta_origin_tl
\tl_new:N \l_wb_meta_source_tl
\tl_new:N \l_wb_meta_url_tl
\tl_new:N \l_wb_meta_prereq_tl
\tl_new:N \l_wb_meta_status_tl

\keys_define:nn { qiworkbook / meta }
  {
    topic       .tl_set:N = \l_wb_meta_topic_tl  ,
    est         .tl_set:N = \l_wb_meta_est_tl    ,
    origin      .tl_set:N = \l_wb_meta_origin_tl ,
    source      .tl_set:N = \l_wb_meta_source_tl ,
    url         .tl_set:N = \l_wb_meta_url_tl    ,
    prereq      .tl_set:N = \l_wb_meta_prereq_tl ,
    status      .tl_set:N = \l_wb_meta_status_tl ,
    unknown     .code:n   =
      { \PackageWarning{qiworkbook}{Unknown~meta~key~'\l_keys_key_str'} } ,
  }

\tl_new:N \l_wb_att_date_tl
\tl_new:N \l_wb_att_time_tl
\tl_new:N \l_wb_att_diff_tl
\tl_new:N \l_wb_att_how_tl
\tl_new:N \l_wb_att_ins_tl
\tl_new:N \l_wb_att_note_tl
\bool_new:N \l_wb_att_public_bool

\keys_define:nn { qiworkbook / attempt }
  {
    date        .tl_set:N   = \l_wb_att_date_tl ,
    time        .tl_set:N   = \l_wb_att_time_tl ,
    difficulty  .tl_set:N   = \l_wb_att_diff_tl ,
    howitwent   .tl_set:N   = \l_wb_att_how_tl  ,
    insight     .tl_set:N   = \l_wb_att_ins_tl  ,
    note        .tl_set:N   = \l_wb_att_note_tl ,
    public      .bool_set:N = \l_wb_att_public_bool ,
    public      .default:n  = true ,
    unknown     .code:n     =
      { \PackageWarning{qiworkbook}{Unknown~attempt~key~'\l_keys_key_str'} } ,
  }

\cs_new_protected:Npn \wb_reset_entry:
  {
    \tl_clear:N \l_wb_meta_topic_tl   \tl_clear:N \l_wb_meta_est_tl
    \tl_clear:N \l_wb_meta_origin_tl  \tl_clear:N \l_wb_meta_source_tl
    \tl_clear:N \l_wb_meta_url_tl     \tl_clear:N \l_wb_meta_prereq_tl
    \tl_clear:N \l_wb_meta_status_tl
    \tl_clear:N \l_wb_att_date_tl     \tl_clear:N \l_wb_att_time_tl
    \tl_clear:N \l_wb_att_diff_tl     \tl_clear:N \l_wb_att_how_tl
    \tl_clear:N \l_wb_att_ins_tl      \tl_clear:N \l_wb_att_note_tl
    \bool_set_false:N \l_wb_att_public_bool
    \cs_gset:Npn \wb@topicfrozen { }
  }
\cs_new_eq:NN \wbresetentry \wb_reset_entry:

% row printer that skips empty fields
\cs_new_protected:Npn \wb_metarow:nN #1#2
  { \tl_if_empty:NF #2 { \item [#1] \tl_use:N #2 } }
\cs_new_eq:NN \wbmetarow \wb_metarow:nN

\cs_new_protected:Npn \wb_att_nonempty:
  {
    \bool_lazy_any:nTF
      {
        { ! \tl_if_empty_p:N \l_wb_att_date_tl }
        { ! \tl_if_empty_p:N \l_wb_att_time_tl }
        { ! \tl_if_empty_p:N \l_wb_att_diff_tl }
        { ! \tl_if_empty_p:N \l_wb_att_how_tl  }
        { ! \tl_if_empty_p:N \l_wb_att_ins_tl  }
        { ! \tl_if_empty_p:N \l_wb_att_note_tl }
      }
      { \wb@attempttrue } { \wb@attemptfalse }
  }
\cs_new_eq:NN \wbattnonempty \wb_att_nonempty:
\cs_new_protected:Npn \wb_att_showp:
  { \bool_if:NTF \l_wb_att_public_bool { \wb@attpubtrue } { \wb@attpubfalse } }
\cs_new_eq:NN \wbattshowp \wb_att_showp:
\ExplSyntaxOff

\newif\ifwb@attempt
\newif\ifwb@attpub

% ---------------------------------------------------------------- meta block --
% \entrymeta{topic=..., est=..., origin=..., source=..., url=..., prereq=..., status=...}
\newcommand{\entrymeta}[1]{%
  \begingroup
  \expandafter\wb@setmetakeys\expandafter{#1}%
  \small\color{wbGrey}%
  \begin{description}[leftmargin=!,labelwidth=\widthof{\bfseries Prerequisites},
      font=\bfseries,itemsep=0.15em,topsep=0.4em,parsep=0pt,before=\raggedright]
    \item[ID] \texttt{\wb@cur@id}%
    \wbmetarow{Topic}{\wb@metatopic}%
    \wbmetarow{Estimated time}{\wb@metaest}%
    \wbmetarow{Origin}{\wb@metaorigin}%
    \wb@sourcerow
    \wbmetarow{Prerequisites}{\wb@metaprereq}%
    \ifwb@public\else\wbmetarow{Status}{\wb@metastatus}\fi
  \end{description}
  \endgroup\medskip}

\ExplSyntaxOn
\cs_new_protected:Npn \wb@setmetakeys #1
  {
    \keys_set:nn { qiworkbook / meta } {#1}
    \cs_set_eq:NN \wb@metatopic  \l_wb_meta_topic_tl
    \cs_set_eq:NN \wb@metaest    \l_wb_meta_est_tl
    \cs_set_eq:NN \wb@metaorigin \l_wb_meta_origin_tl
    \cs_set_eq:NN \wb@metaprereq \l_wb_meta_prereq_tl
    \cs_set_eq:NN \wb@metastatus \l_wb_meta_status_tl
    % freeze under a plain (non-expl3) name so the ledger write can grab it
    \cs_gset_eq:NN \wb@topicfrozen \l_wb_meta_topic_tl
  }
\cs_new_protected:Npn \wb@sourcerow
  {
    \tl_if_empty:NF \l_wb_meta_source_tl
      {
        \item [Source]
        \tl_if_empty:NTF \l_wb_meta_url_tl
          { \tl_use:N \l_wb_meta_source_tl }
          {
            \href { \l_wb_meta_url_tl } { \tl_use:N \l_wb_meta_source_tl }
          }
      }
  }
\ExplSyntaxOff

% -------------------------------------------------------------------- entry --
% \begin{entry}{Q005}{Two POVMs that never disagree} ... \end{entry}
\newenvironment{entry}[2]{%
  \wbresetentry
  \renewcommand{\wb@cur@id}{#1}%
  \renewcommand{\wb@cur@title}{#2}%
  \phantomsection
  \section[{#2}\ \textnormal{(#1)}]{#2}%
  \hypertarget{#1}{}%
  \protected@write\@auxout{}{\string\wb@setqday{#1}{\wb@curday}}%
}{%
  \wb@writeledgerrow
  \par\medskip\wbthinrule\medskip
}

\newcommand{\wb@setqday}[2]{\global\@namedef{wb@qday@#1}{#2}}

% =============================================================================
%  Attempt log
% =============================================================================
\newcommand{\attempt}[1]{%
  \begingroup
  \wb@setattkeys{#1}%
  \wbattnonempty \wbattshowp
  \ifwb@attempt
    \ifwb@public \ifwb@attpub \wb@printattempt \fi
    \else \wb@printattempt \fi
  \fi
  \wb@stashattempt
  \endgroup}

\ExplSyntaxOn
\cs_new_protected:Npn \wb@setattkeys #1
  { \keys_set:nn { qiworkbook / attempt } {#1} }

\cs_new_protected:Npn \wb@printattempt
  {
    \par\medskip
    \group_begin:
    \small
    \noindent {\bfseries\color{wbInk} Attempt~log}\par\nobreak
    \vspace{0.2em}
    \begin{description}
      [leftmargin=!,labelwidth=\widthof{\bfseries How~it~went},
       font=\bfseries,itemsep=0.1em,topsep=0.2em,parsep=0pt,before=\raggedright]
      \tl_if_empty:NF \l_wb_att_date_tl
        { \item [Date] \wbdate { \l_wb_att_date_tl } }
      \tl_if_empty:NF \l_wb_att_time_tl
        { \item [Time] \tl_use:N \l_wb_att_time_tl }
      \tl_if_empty:NF \l_wb_att_diff_tl
        { \item [Difficulty] \tl_use:N \l_wb_att_diff_tl \c_space_tl / \c_space_tl 5 }
      \tl_if_empty:NF \l_wb_att_how_tl
        { \item [How~it~went] \tl_use:N \l_wb_att_how_tl }
      \tl_if_empty:NF \l_wb_att_ins_tl
        { \item [Insight] \tl_use:N \l_wb_att_ins_tl }
      \tl_if_empty:NF \l_wb_att_note_tl
        { \item [Note] \tl_use:N \l_wb_att_note_tl }
    \end{description}
    \group_end:
    \par\medskip
  }

% stash the attempt data so \end{entry} can emit one ledger row
\cs_new_protected:Npn \wb@stashattempt
  {
    \tl_gset_eq:NN \g_wb_stash_date_tl \l_wb_att_date_tl
    \tl_gset_eq:NN \g_wb_stash_time_tl \l_wb_att_time_tl
    \tl_gset_eq:NN \g_wb_stash_diff_tl \l_wb_att_diff_tl
  }
\tl_new:N \g_wb_stash_date_tl
\tl_new:N \g_wb_stash_time_tl
\tl_new:N \g_wb_stash_diff_tl
\ExplSyntaxOff

% =============================================================================
%  Ledger.  Rows are written to the .aux and read back on the next run, which
%  is why the table in the front matter needs two compilations to settle.
% =============================================================================
\newcommand{\wb@writeledgerrow}{%
  \immediate\write\@auxout{%
    \string\wbledgerrow
      {\wb@cur@id}%
      {\wb@curday}%
      {\wb@effdate}%
      {\unexpanded\expandafter{\wb@cur@title}}%
      {\unexpanded\expandafter{\wb@topicfrozen}}%
      {\wb@stashtime}%
      {\wb@stashdiff}}%
  \wb@clearstash}

\ExplSyntaxOn
\cs_new:Npn \wb@stashdate { \tl_use:N \g_wb_stash_date_tl }
% The date an entry is filed under: whatever \attempt said, otherwise the date
% of the session it sits in.  Expandable, because it is used inside \write.
\cs_new:Npn \wb@effdate
  {
    \tl_if_empty:NTF \g_wb_stash_date_tl
      { \wb@sessiondate }
      { \tl_use:N \g_wb_stash_date_tl }
  }
\cs_new:Npn \wb@stashtime { \tl_use:N \g_wb_stash_time_tl }
\cs_new:Npn \wb@stashdiff { \tl_use:N \g_wb_stash_diff_tl }

\cs_new_protected:Npn \wb@clearstash
  {
    \tl_gclear:N \g_wb_stash_date_tl
    \tl_gclear:N \g_wb_stash_time_tl
    \tl_gclear:N \g_wb_stash_diff_tl
  }
\ExplSyntaxOff

% small counters kept under macro names, used for the per-year tallies
\newcommand{\wb@bump}[1]{%
  \expandafter\ifx\csname #1\endcsname\relax
    \global\@namedef{#1}{1}%
  \else
    \edef\wb@tmp{\the\numexpr\csname #1\endcsname+1\relax}%
    \global\expandafter\let\csname #1\endcsname\wb@tmp
  \fi}
\newcommand{\wb@get}[1]{%
  \expandafter\ifx\csname #1\endcsname\relax 0\else\csname #1\endcsname\fi}

\ExplSyntaxOn
\seq_new:N \g_wb_years_seq
\cs_new_protected:Npn \wb@addyear #1
  {
    \tl_set:Nx \l_tmpa_tl { \str_range:nnn {#1} {1} {4} }
    \seq_if_in:NVF \g_wb_years_seq \l_tmpa_tl
      { \seq_gput_right:NV \g_wb_years_seq \l_tmpa_tl }
    \use:x { \exp_not:N \wb@bump { wb@yp@ \l_tmpa_tl } }
  }
\cs_new_protected:Npn \wb@addday #1
  {
    \tl_set:Nx \l_tmpa_tl { \str_range:nnn {#1} {1} {4} }
    \use:x { \exp_not:N \wb@bump { wb@yd@ \l_tmpa_tl } }
  }
% \wbcalendarauto -- one grid per year that has entries, oldest first
\cs_new_protected:Npn \wbcalendarauto
  {
    \seq_if_empty:NTF \g_wb_years_seq
      { \wb@ledgerempty }
      {
        \seq_sort:Nn \g_wb_years_seq
          { \int_compare:nNnTF {##1} > {##2} { \sort_return_swapped: }
            { \sort_return_same: } }
        \seq_map_inline:Nn \g_wb_years_seq
          {
            \wbyearhead {##1}
            \noindent \wbcalendar {##1} \par
            \vspace { 1.8 \baselineskip }
          }
        \vspace { -1.2 \baselineskip }
        \wbcalendarlegend
      }
  }
\ExplSyntaxOff

\newcommand{\wb@ledgerrows}{}
