% =============================================================================
%  Calendar grid (the "album" page).  Purely visual; navigation is the ledger.
% =============================================================================
% Geometry in millimetres, as bare numbers so pgfmath can use them directly.
\def\wbcellsize{2.35}
\def\wbcellpitch{2.90}

% Drawing helpers.  The picture sets x=y=pitch, so all coordinates below are
% plain integers: column to the right, row downwards.
\newcommand{\wb@rowlabel}[2]{%
  \node[anchor=east,font=\tiny,text=wbGrey] at (-0.4,-#1+0.4) {#2};}
\newcommand{\wb@monthlabel}[2]{%
  \node[anchor=south west,font=\tiny,text=wbGrey] at (#1,0.9) {#2};}
\newcommand{\wb@cell}[3]{%
  \fill[#3,rounded corners=0.25mm]
    (#1,-#2) rectangle ++(\wbcellsize mm,\wbcellsize mm);}

\ExplSyntaxOn
\int_new:N \l__wb_pos_int
\int_new:N \l__wb_cnt_int
\int_new:N \l__wb_jan_int

\cs_new_protected:Npn \wb_cal_lookup:n #1
  {
    \cs_if_exist:cTF { wb@cnt@ #1 }
      { \int_set:Nn \l__wb_cnt_int { \use:c { wb@cnt@ #1 } } }
      { \int_zero:N \l__wb_cnt_int }
  }
\cs_generate_variant:Nn \wb_cal_lookup:n { x }

% #1 = day of year, #2 = position index (0-based, column-major over weeks)
\cs_new_protected:Npn \wb_cal_day:nn #1#2
  {
    \int_set:Nn \l__wb_m_int { 1 }
    \int_step_inline:nnnn {1} {1} {12}
      {
        \int_compare:nNnT
          {
            \__wb_cumdays:n {##1}
            + \int_compare:nNnTF {##1} > {2}
                { \__wb_isleap:n { \l__wb_y_int } } {0}
          }
          < {#1}
          { \int_set:Nn \l__wb_m_int {##1} }
      }
    \int_set:Nn \l__wb_d_int
      {
        #1 - \__wb_cumdays:n { \l__wb_m_int }
        - \int_compare:nNnTF { \l__wb_m_int } > {2}
            { \__wb_isleap:n { \l__wb_y_int } } {0}
      }
    \wb_cal_lookup:x
      {
        \int_use:N \l__wb_y_int - \__wb_pad:n { \l__wb_m_int }
        - \__wb_pad:n { \l__wb_d_int }
      }
    \use:x
      {
        \exp_not:N \wb@cell
          { \int_eval:n { \int_div_truncate:nn {#2} {7} } }
          { \int_eval:n { \int_mod:nn {#2} {7} } }
          {
            \int_compare:nNnTF { \l__wb_cnt_int } = {0}
              { wbFaint }
              {
                \int_compare:nNnTF { \l__wb_cnt_int } > {1}
                  { wbAccent } { wbAccent!55 }
              }
          }
      }
  }

\cs_new_protected:Npn \wb_calendar:n #1
  {
    \int_set:Nn \l__wb_y_int {#1}
    \int_set:Nn \l__wb_jan_int { \__wb_dow:nnn {#1} {1} {1} }
    \begin{tikzpicture}[ x = \wbcellpitch mm , y = \wbcellpitch mm , baseline ]
      % weekday labels: Mon, Wed, Fri (rows 1, 3, 5 with Sunday = row 0)
      \int_step_inline:nnnn {1} {2} {5}
        { \wb@rowlabel {##1} { \int_case:nnF {##1} { {1}{Mon} {3}{Wed} {5}{Fri} } { } } }
      % every day of the year
      \int_step_variable:nnNn {1}
        { \int_eval:n { 365 + \__wb_isleap:n {#1} } } \l_tmpa_tl
        {
          \int_set:Nn \l__wb_pos_int { \l__wb_jan_int + \l_tmpa_tl - 1 }
          \wb_cal_day:nn { \l_tmpa_tl } { \l__wb_pos_int }
        }
      % month labels, above the column containing the 1st
      \int_step_inline:nnnn {1} {1} {12}
        {
          \use:x
            {
              \exp_not:N \wb@monthlabel
                {
                  \int_eval:n
                    {
                      \int_div_truncate:nn
                        { \l__wb_jan_int + \__wb_doy:nnn {#1} {##1} {1} - 1 } {7}
                    }
                }
                { \__wb_month_abbr:n {##1} }
            }
        }
    \end{tikzpicture}
  }
\cs_new_eq:NN \wbcalendar \wb_calendar:n
\ExplSyntaxOff

\newcommand{\wbyearhead}[1]{%
  \begingroup
  \edef\wb@np{\wb@get{wb@yp@#1}}\edef\wb@nd{\wb@get{wb@yd@#1}}%
  \parfillskip=0pt\relax
  \par\noindent
  {\Large\bfseries\color{wbInk}#1}%
  \hfill
  {\small\color{wbGrey}%
    \wb@np\ problem\ifnum\wb@np=1\relax\else s\fi
    \ \textbullet\
    \wb@nd\ day\ifnum\wb@nd=1\relax\else s\fi}%
