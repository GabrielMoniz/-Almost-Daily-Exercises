% #1 id  #2 day  #3 ISO date  #4 title  #5 topic  #6 time  #7 difficulty
\newcommand{\wbledgerrow}[7]{%
  \stepcounter{wb@nentries}%
  \ifx\relax#3\relax\else\wb@addyear{#3}\fi
  \g@addto@macro\wb@ledgerrows{\wb@fmtrow{#1}{#2}{#3}{#4}{#5}{#6}{#7}}%
  \ifx\relax#3\relax\else
    \expandafter\ifx\csname wb@cnt@#3\endcsname\relax
      \stepcounter{wb@ndays}\wb@addday{#3}%
      \expandafter\g@addto@macro\expandafter\wb@datelist\expandafter{#3,}%
      \global\@namedef{wb@cnt@#3}{1}%
    \else
      \edef\wb@tmp{\the\numexpr\csname wb@cnt@#3\endcsname+1\relax}%
      \global\expandafter\let\csname wb@cnt@#3\endcsname\wb@tmp
    \fi
  \fi}

% Two row macros rather than one with a conditional: an "&" inside \if...\fi
% breaks alignment scanning.  \wb@fmtrow is \let to the right one at use time.
\newcommand{\wb@dash}{\textcolor{wbGrey}{--}}
\newcommand{\wb@fmtrowfull}[7]{%
  \hyperlink{#1}{\texttt{#1}} & #2 &
  \ifx\relax#3\relax\wb@dash\else\wbdate{#3}\fi &
  \hyperlink{#1}{#4} & #5 &
  \ifx\relax#6\relax\wb@dash\else#6\fi &
  \ifx\relax#7\relax\wb@dash\else#7\fi \\}
\newcommand{\wb@fmtrowpub}[7]{%
  \hyperlink{#1}{\texttt{#1}} & #2 &
  \ifx\relax#3\relax\wb@dash\else\wbdate{#3}\fi &
  \hyperlink{#1}{#4} & #5 \\}
\let\wb@fmtrow\wb@fmtrowfull

\newcommand{\wb@headfull}{%
  \textbf{ID} & \textbf{Day} & \textbf{Date} & \textbf{Title} & \textbf{Topic} &
  \textbf{Time} & \textbf{D} \\}
