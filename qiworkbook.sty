% =============================================================================
%  Toolbox: recurring lemmas, with back-references to the entries that use them
% =============================================================================
\newcommand{\wb@tooluses}[2]{%
  \expandafter\ifx\csname wb@tool@#1\endcsname\relax
    \global\@namedef{wb@tool@#1}{#2}%
  \else
    \edef\wb@tmp{\csname wb@tool@#1\endcsname, #2}%
    \global\expandafter\let\csname wb@tool@#1\endcsname\wb@tmp
  \fi}

% \usetool{T1} inside a solution
\newcommand{\usetool}[1]{%
  \hyperlink{tool:#1}{\textbf{#1}}%
  \protected@write\@auxout{}{\string\wb@tooluses{#1}{\wb@cur@id}}}

% \begin{tool}{T1}{Vanishing expectation} ... \end{tool}
\newenvironment{tool}[2]{%
  \par\medskip\phantomsection\hypertarget{tool:#1}{}%
  \def\wb@thistool{#1}%
  \noindent{\bfseries\color{wbInk}#1.\ #2.}\ \itshape\ignorespaces
}{%
  \upshape\par\nobreak\vspace{0.2em}%
  {\small\color{wbGrey}Used in:\ %
    \expandafter\ifx\csname wb@tool@\wb@thistool\endcsname\relax
      not yet\else
      \wb@linkids{\csname wb@tool@\wb@thistool\endcsname}\fi\par}%
  \medskip}

\ExplSyntaxOn
\cs_new_protected:Npn \wb@linkids #1
  {
    \clist_set:Nn \l_tmpa_clist {#1}
    \clist_remove_duplicates:N \l_tmpa_clist
    \tl_clear:N \l_tmpa_tl
    \clist_map_inline:Nn \l_tmpa_clist
      {
        \tl_if_empty:NF \l_tmpa_tl { \tl_put_right:Nn \l_tmpa_tl { ,~ } }
        \tl_put_right:Nn \l_tmpa_tl { \hyperlink {##1} { \texttt {##1} } }
      }
    \tl_use:N \l_tmpa_tl
  }
\ExplSyntaxOff

